{# Jeden wpis dziennika: co sklep wysłał i co odpowiedział Notifuse. Wzór: szczegół zdarzenia quince_events. #}
{% extends '@Modules/quince_engine/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quincenotifuse.Admin' %}

{% set rodzaje = { 'contact': 'Contact'|trans, 'subscribe': 'List sign-up'|trans, 'list_status': 'List status'|trans, 'event': 'Event'|trans } %}
{% set badge = { 'pending': 'qc-badge-warning', 'sent': 'qc-badge-success', 'failed': 'qc-badge-danger' } %}
{% set stany = { 'pending': 'Waiting'|trans, 'sent': 'Sent'|trans, 'failed': 'Failed'|trans } %}

{% block quince_body %}
<div class="qc-stack">
    <div>
        <a href="{{ path('quince_notifuse_log') }}" style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--fg-2); margin-bottom:10px">
            {# Zestaw ikon silnika nie ma strzałki w lewo: ta sama siatka 16×16 i obrys. #}
            <svg class="qc-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4 6 8l4 4"/></svg>
            {{ 'Log'|trans }}
        </a>
        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap">
            <div style="font-size:22px; font-weight:800">{{ rodzaje[wpis.kind]|default(wpis.kind) }} <code>{{ wpis.label }}</code></div>
            <span class="qc-badge {{ badge[wpis.status] }}">{{ stany[wpis.status] }}</span>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:20px; align-items:start">
        <div class="qc-stack">
            <div class="qc-card">
                <div class="qc-card-head"><div class="qc-card-title">{{ 'What the shop sends'|trans }}</div></div>
                <div class="qc-card-body">
                    <pre style="margin:0; white-space:pre-wrap; font-size:12px">{{ tresc }}</pre>
                </div>
            </div>

            {% if wpis.last_error %}
                <div class="qc-card">
                    <div class="qc-card-head"><div class="qc-card-title">{{ 'Last answer from Notifuse'|trans }}</div></div>
                    <div class="qc-card-body">
                        <p class="qc-muted" style="margin:0">{{ wpis.last_error }}</p>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="qc-stack">
            <div class="qc-card">
                <div class="qc-card-head"><div class="qc-card-title">{{ 'Information'|trans }}</div></div>
                <div class="qc-card-body">
                    <dl style="display:grid; grid-template-columns:auto 1fr; gap:4px 12px; font-size:13px; margin:0">
                        <dt style="color:var(--fg-3)">{{ 'Contact'|trans }}</dt><dd style="margin:0; text-align:right; word-break:break-all">{{ wpis.email }}</dd>
                        <dt style="color:var(--fg-3)">{{ 'Submitted'|trans }}</dt><dd style="margin:0; text-align:right">{{ wpis.date_add|date('Y-m-d H:i') }}</dd>
                        <dt style="color:var(--fg-3)">{{ 'Attempts'|trans }}</dt><dd style="margin:0; text-align:right">{{ wpis.attempts }} / {{ maxProb }}</dd>
                        {% if wpis.status == 'pending' and wpis.next_try_at > 0 %}
                            <dt style="color:var(--fg-3)">{{ 'Next attempt'|trans }}</dt><dd style="margin:0; text-align:right">{{ wpis.next_try_at|date('Y-m-d H:i') }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>

            {% if wpis.status != 'sent' %}
                <div class="qc-card">
                    <div class="qc-card-body">
                        <form method="post" action="{{ path('quince_notifuse_log_retry', {id: wpis.id_quince_notifuse_outbox}) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_notifuse_log_retry') }}">
                            <button type="submit" class="qc-btn qc-btn-primary" style="width:100%; justify-content:center">{{ 'Send now'|trans }}</button>
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
